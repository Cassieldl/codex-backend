# Variáveis da API do Codex em PRODUÇÃO (004). Valores fictícios — o arquivo real nunca é
# commitado, e em ambiente gerenciado estes valores vêm do vault do provedor (Secret Manager),
# nunca de um .env em disco.
#
# Diferenças que importam em relação ao .env.example de desenvolvimento estão comentadas.

# --- Banco ------------------------------------------------------------------------------------
# Usuário da APLICAÇÃO, com permissão mínima no schema do módulo — nunca o superusuário
# `postgres` (rules/security.md). SSL obrigatório: a conexão sai da instância.
ConnectionStrings__Default=Host=10.0.0.10;Port=5432;Database=codex_db;Username=codex_user;Password=troque-me;SSL Mode=Require;Trust Server Certificate=false

# As variáveis POSTGRES_* e CODEX_APP_DB_PASSWORD do desenvolvimento NÃO existem aqui: elas
# alimentam o docker-compose local, que provisiona o banco. Em produção o banco é gerenciado.

# --- Keycloak ---------------------------------------------------------------------------------
# Realm e client reais. `ValidAudiences` é explícito de propósito: sem ele, um token emitido para
# outro client do mesmo realm seria aceito.
Keycloak__auth-server-url=https://auth.exemplo.com.br
Keycloak__realm=troque-me
Keycloak__resource=codex-backend
Keycloak__ValidAudiences__0=codex-backend
# Opcional: endereço INTERNO do documento de descoberta, quando a API alcança o Keycloak por um nome
# que o navegador não conhece (service do cluster, rede privada). O issuer continua o público.
# Atenção: o jwks_uri vem DENTRO do documento, montado pelo KC_HOSTNAME do Keycloak — a API precisa
# alcançar aquele endereço também (docs/producao.md).
# Keycloak__MetadataAddress=http://keycloak.interno:8080/realms/troque-me/.well-known/openid-configuration
# Só quando o Keycloak fica numa rede interna com TLS terminado antes dele: sem isto a aplicação
# recusa subir com Authority em HTTP fora de Development. Declarar é assumir o risco.
# Keycloak__RequireHttpsMetadata=false

# --- Rede ---------------------------------------------------------------------------------
# Origem exata do portal. Nunca "*" — CORS restritivo é eliminatório no checklist de produção.
Cors__OrigemPermitida=https://codex.exemplo.com.br

# Hosts servidos por este ambiente. Fora de Development a aplicação RECUSA subir com "*".
AllowedHosts=codex-api.exemplo.com.br

# O ingress que termina TLS. Sem declarar: HSTS não é emitido e o rate limiting colapsa numa
# partição única, porque todo request chega com o IP do proxy. Nunca use curinga — seria
# permitir spoofing de IP do cliente.
ProxyReverso__KnownProxies__0=10.0.0.1
ProxyReverso__KnownNetworks__0=10.0.0.0/8
ProxyReverso__ForwardLimit=1

# --- Busca --------------------------------------------------------------------------------
Busca__LimiarAutocorrecao=0.45
# statement_timeout do /busca, em ms. A aplicação recusa subir fora de 250..30000: 0 desligaria a
# proteção de custo do endpoint anônimo.
Busca__TimeoutMs=2000
# Orçamento de parede por requisição de busca (a cascata de autocorreção roda vários statements).
# Mesmos limites: 250..30000. 0 desligaria a única proteção da cascata anônima.
Busca__OrcamentoRequisicaoMs=2000

# --- Comunicados ----------------------------------------------------------------------------
# Job que tira do ar o comunicado vencido. Com mais de uma instância, todas rodam o job; a
# operação é idempotente, então só se paga em consultas repetidas.
Comunicados__ExpiracaoHabilitada=true
Comunicados__IntervaloExpiracaoSegundos=300

# --- Plataforma ---------------------------------------------------------------------------
# Production desliga o Swagger e liga o pipeline de produção (fail-fast de configuração).
ASPNETCORE_ENVIRONMENT=Production
# Porta interna do container. O mapeamento externo é decidido por quem publica.
ASPNETCORE_HTTP_PORTS=8080
