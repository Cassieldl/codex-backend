{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning"
      }
    }
  },
  "AllowedHosts": "localhost;127.0.0.1;[::1]",
  "ConnectionStrings": {
    "Default": ""
  },
  "Keycloak": {
    "auth-server-url": "",
    "realm": "codex",
    "resource": "codex-backend",
    "ValidAudiences": ["codex-backend"]
  },
  "Cors": {
    "OrigemPermitida": ""
  },
  "ProxyReverso": {
    "KnownProxies": [],
    "KnownNetworks": [],
    "ForwardLimit": 1
  },
  "Busca": {
    "LimiarAutocorrecao": 0.45,
    "TimeoutMs": 2000,
    "OrcamentoRequisicaoMs": 2000
  },
  "Comunicados": {
    "ExpiracaoHabilitada": true,
    "IntervaloExpiracaoSegundos": 300
  }
}
