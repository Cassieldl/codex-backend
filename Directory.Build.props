<Project>

  <!-- Aviso novo reprova o build em todos os projetos da solution, inclusive o de testes. -->
  <PropertyGroup>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <!-- Transitivas presas por hash no packages.lock.json; CI e Dockerfile restauram com locked-mode. -->
  <PropertyGroup>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>

</Project>
