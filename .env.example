ConnectionStrings__Default=Host=localhost;Port=5432;Database=codex_db;Username=codex_user;Password=troque-me
POSTGRES_USER=postgres
POSTGRES_PASSWORD=troque-me-superuser
POSTGRES_DB=codex_db
CODEX_APP_DB_PASSWORD=troque-me
Keycloak__auth-server-url=http://localhost:8080
Keycloak__realm=codex
Keycloak__resource=codex-backend
Keycloak__ValidAudiences__0=codex-backend
Cors__OrigemPermitida=http://localhost:5173
Busca__LimiarAutocorrecao=0.45
# Busca__TimeoutMs: statement_timeout do /busca. 0 DESLIGA o timeout no Postgres (remove a
# protecao de custo do endpoint anonimo) e negativo faz todo SET LOCAL falhar — a aplicacao
# recusa subir com valor fora de 250..30000.
Busca__TimeoutMs=2000
# Orçamento de parede da requisição de busca inteira (mesmos limites do TimeoutMs).
Busca__OrcamentoRequisicaoMs=2000
Comunicados__ExpiracaoHabilitada=true
Comunicados__IntervaloExpiracaoSegundos=300
# Hosts servidos por este ambiente. Fora de Development a aplicacao recusa subir com "*".
AllowedHosts=localhost;127.0.0.1;[::1]
# Proxies/redes cuja X-Forwarded-For e X-Forwarded-Proto sao honradas. Loopback ja e confiavel
# por padrao. Sem declarar o ingress: HSTS nao e emitido e o rate limit do /busca vira balde
# global. Nunca use curinga aqui — seria spoofing de IP.
ProxyReverso__KnownProxies__0=
ProxyReverso__KnownNetworks__0=
ProxyReverso__ForwardLimit=1
KEYCLOAK_ADMIN_PASSWORD=troque-me
